{
  "name": "@nextjs-devtools/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "test:e2e": "pnpm build:preview && playwright test"
  },
  "dependencies": {
    "@nextjs-devtools/flight-parser": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2"
  }
}
